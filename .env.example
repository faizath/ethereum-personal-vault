# Copy to `.env` (git-ignored) and fill in. Forge loads `.env` automatically; for cast, run `source .env`.
#
# There is deliberately NO private key variable. Pass the signer on the command line instead:
#   --account deployer                     (recommended: encrypted keystore, `cast wallet import deployer --interactive`)
#   --private-key "$(cat /path/to/key)"    (key read from a file outside the repo, never pasted into history)

# --- Network -------------------------------------------------------------------------------------
# Any Sepolia RPC works (public endpoint below, or Infura/Alchemy with your own key).
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ETHERSCAN_API_KEY=<YOUR_ETHERSCAN_API_KEY>

# --- Deployment (script/Deploy.s.sol) ------------------------------------------------------------
# Absolute unlock timestamp in SECONDS (not milliseconds). Leave commented out to use LOCK_DURATION.
# UNLOCK_TIME=1767225600
# Lock length in seconds from the deployment block, used when UNLOCK_TIME is unset (default 600).
LOCK_DURATION=600
# Wei to lock at deployment (0 = deploy empty). 1000000000000000 = 0.001 ETH.
INITIAL_DEPOSIT=0

# --- Interaction (script/Interact.s.sol and cast) ------------------------------------------------
VAULT_ADDRESS=<DEPLOYED_VAULT_ADDRESS>
# Wei per deposit (default 0.001 ETH).
DEPOSIT_AMOUNT=1000000000000000
# Either an absolute new unlock timestamp, or seconds to extend by (default 300).
# NEW_UNLOCK_TIME=1767312000
EXTEND_BY=300
